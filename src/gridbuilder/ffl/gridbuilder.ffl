/** grid-builder in FFL — power-grid models from OpenStreetMap.
  *
  * The Facetwork equivalent of PyPSA's `grid-builder`, a Snakemake workflow
  * (https://github.com/PyPSA/grid-builder). It does the SAME work with the SAME
  * extraction library (`earth_osm`); only the orchestrator differs, which is the
  * point — a comparison where the payload changes too compares nothing.
  *
  * SCOPE. Upstream's README describes four stages (retrieve → clean/infer →
  * topology → validate) but as of commit 2f20a35 only **retrieve** is
  * implemented: `rule retrieve_osm` (one country) and `rule retrieve_osm_all`
  * (the aggregate). This ports that, and nothing is claimed about the three
  * stages neither project has built. `ValidateRetrieval` below is deliberately
  * beyond parity and is marked as such.
  *
  * THE STRUCTURE BEING COMPARED. Snakemake fans out with a double `expand()`
  * over countries × features and infers the DAG backwards from the requested
  * files:
  *
  *     rule retrieve_osm_all:
  *         input: expand("{country}_{feature}.csv",
  *                       country=config["countries"], feature=config["retrieve"]["features"])
  *
  * Here the same fan-out is two nested `foreach` blocks, and the work list is a
  * value that arrives at run time rather than a wildcard resolved against the
  * submitting machine's filesystem. `limit` bounds how many countries are in
  * flight, because each one downloads a regional PBF — that is a shared network
  * and a shared scratch disk, not a reason to open fifty sockets at Geofabrik.
  *
  * THE REUSE DECISION is where the two differ most, and it is the subject of
  * the thesis' §13.3. Snakemake skips `retrieve_osm` when its outputs exist and
  * are newer than their inputs; the rule has no file inputs, so in practice the
  * outputs are never rebuilt until someone passes `force_redownload` by hand.
  * `Retrieve` records what produced each artifact — the extractor's version, the
  * source, the OSM feature counts — and reuses only when those still match. */
namespace grid.osm {
    use fw.file

    /** What one (country, feature) extraction produced. */
    schema FeatureSet {
        country: String,
        feature: String,
        csv_path: String,
        geojson_path: String,
        elements: Int,
        was_cached: Boolean
    }

    /** Retrieve ONE OSM power feature for ONE country — the unit of work, and
      * the exact granularity of upstream's `rule retrieve_osm`.
      *
      * `source` is `geofabrik` (regional PBF extract, what upstream defaults to)
      * or `overpass` (live API, better for a single small region). `out_dir` is
      * storage-aware: a local path, `s3://…` or `hdfs://…`, so the same workflow
      * runs on a laptop and on a fleet whose data lives in the object store.
      *
      * Reuse is decided on the recorded extractor version + source + feature
      * set, not on the output file existing. `force` overrides it. */
    event facet Retrieve(
        country: String,
        feature: String,
        out_dir: String,
        primary_name: String = "power",
        source: String = "geofabrik",
        force: Boolean = false,
        // OFF by default under the runtime. earth-osm's multiprocessing FORKS,
        // and forking a runner that holds logging/Mongo locks in other threads
        // deadlocks the children — observed on the fleet as a task stuck
        // "running" for 20+ minutes at 0.6% CPU with 19 live processes and no
        // output. The CLI is single-threaded, so `retrieve_osm.py` still
        // defaults it on; pass mp = true here only if you know the caller is not
        // threaded.
        mp: Boolean = false,
        stream_backend: Boolean = true,
        cache_primary: Boolean = false,
        target_date: String = "",
        use_mock: Boolean = false
    ) => (
        result: FeatureSet
    ) with RetryPolicy() with Effect(kind = "external") with Cost(tier = "expensive")

    /** Retrieve ONE feature from a PBF the caller supplies — no download.
      *
      * BEYOND UPSTREAM PARITY. Same extractor as `Retrieve`; earth_osm is
      * pointed at `pbf` (local path or s3://) and never reaches Geofabrik.
      * `region` names the earth_osm region the file stands for (`europe`,
      * `LU`) and only labels the outputs. A separate facet rather than a
      * `Retrieve` parameter so a runner without this code cannot claim the work
      * and silently fall back to downloading.
      *
      * Pair with `Prefilter`: earth_osm parses every block in pure Python, so a
      * continent is seconds filtered and hours raw. Memory follows the number of
      * power features (~13 KB each), not the size of the source. */
    event facet RetrieveFromPbf(
        region: String,
        feature: String,
        pbf: String,
        out_dir: String,
        primary_name: String = "power",
        force: Boolean = false,
        memory_gb: Int = 0
    ) => (
        result: FeatureSet
    ) with RetryPolicy() with Effect(kind = "io") with Cost(tier = "expensive")

    /** Reduce a large PBF to the objects carrying `primary_name`.
      *
      * BEYOND UPSTREAM PARITY. `osmium tags-filter nwr/<primary_name>` keeps
      * every node/way/relation with the key plus the nodes and members they
      * reference, which is exactly what earth_osm needs; the extractor then runs
      * unchanged on the small result. Same rows either way (verified on
      * Luxembourg and Central America); 4.6 GB of South America becomes 23 MB.
      *
      * The output name carries the source's identity (size + etag), so a
      * refreshed continent is re-filtered rather than matched to the old one. */
    event facet Prefilter(
        pbf: String,
        out_dir: String,
        primary_name: String = "power",
        force: Boolean = false
    ) => (
        filtered: String,
        source_bytes: Long,
        filtered_bytes: Long,
        was_cached: Boolean
    ) with RetryPolicy() with Effect(kind = "io") with Cost(tier = "expensive") with Requires(memory_gb = 4)

    /** Count what came out and refuse an empty extraction.
      *
      * BEYOND UPSTREAM PARITY — grid-builder has no validate stage yet. It is
      * here because an empty result is the failure this domain is most likely to
      * produce silently: a country code that Geofabrik spells differently, or a
      * feature that has no elements in that extract, yields a valid CSV with a
      * header and no rows. Downstream that becomes a grid with no substations,
      * which looks like a modelling result rather than a missing download. */
    event facet ValidateRetrieval(
        csv_path: String,
        min_elements: Int = 1
    ) => (
        elements: Int,
        ok: Boolean,
        detail: String
    ) with Effect(kind = "io") with Cost(tier = "cheap")

    /** Render retrieved layers as one self-contained HTML map.
      *
      * BEYOND UPSTREAM PARITY — grid-builder ships a map image in its README
      * but has no rule that makes one; its output is model-ready CSV/GeoJSON
      * for PyPSA-Eur. This exists because looking at a grid extract catches
      * what a row count cannot: substations clustered on one junction, lines
      * that stop at an old border, an extract of the wrong region.
      *
      * The GeoJSON is embedded in the page, so the file works from `file://`,
      * from the local gallery, and from an object store — `dest` may be a
      * local path or `s3://`. */
    event facet BuildMap(
        geojson_paths: Json,
        dest: String,
        title: String = "OpenStreetMap power grid"
    ) => (
        path: String,
        features: Int
    ) with Effect(kind = "io") with Cost(tier = "cheap")

    /** Every feature for one country — the inner `expand()` over features. */
    facet RetrieveCountry(
        country: String,
        features: Json,
        out_dir: String,
        primary_name: String,
        source: String,
        force: Boolean,
        use_mock: Boolean
    ) => (
        sets: Json
    )
        // `limit 1` — the features of ONE country all read the SAME regional
        // PBF out of earth-osm's shared cache. Run them concurrently and they
        // race: one re-downloads the extract while another is reading it, and
        // the loser dies with FileNotFoundError on a path that existed a
        // moment ago (reproduced on the fleet: substation ok, line failed).
        // The PBF is the contended resource, so the loop that shares it is the
        // one that gets bounded — countries still fan out in parallel, since
        // each pulls a different extract.
        andThen foreach f in $.features limit 1 {
        got = Retrieve(
            country = $.country,
            feature = $.f,
            out_dir = $.out_dir,
            primary_name = $.primary_name,
            source = $.source,
            force = $.force,
            use_mock = $.use_mock
        )
        // `+=` aggregates across iterations. A bare `=` assigns, so each
        // iteration would overwrite the last and the fan-out would report ONE
        // result while every Retrieve still ran (the validator warns:
        // YIELD_FOREACH_OVERWRITES). Order follows iteration, not completion.
        yield RetrieveCountry(sets += got.result)
    }

    /** Retrieve OSM power infrastructure for a set of countries.
      *
      * The equivalent of upstream's `rule retrieve_osm_all` / `rule all`. The
      * two `foreach` levels are the two `expand()` dimensions; `concurrency`
      * bounds the outer one (0 = unbounded).
      *
      * Defaults match `config/config.yaml` upstream, so the comparison starts
      * from the same configuration rather than a friendlier one. */
    workflow BuildGrid(
        countries: Json,
        features: Json,
        out_dir: String,
        primary_name: String = "power",
        source: String = "geofabrik",
        force: Boolean = false,
        concurrency: Int = 2,
        use_mock: Boolean = false
    ) => (
        sets: Json,
        countries_done: Int
    ) andThen foreach c in $.countries limit $.concurrency {
        country = RetrieveCountry(
            country = $.c,
            features = $.features,
            out_dir = $.out_dir,
            primary_name = $.primary_name,
            source = $.source,
            force = $.force,
            use_mock = $.use_mock
        )
        // `country.sets` is already a list, so `+=` EXTENDS rather than nests
        // — the workflow's `sets` is every (country, feature) pair.
        yield BuildGrid(sets += country.sets, countries_done = 1)
    }

    /** Every feature for one region from one supplied PBF. Unlike
      * `RetrieveCountry` the features need no `limit 1`: each extraction
      * copies the PBF into its own private directory, so there is no shared
      * download to race on. */
    facet RetrieveRegion(
        region: String,
        features: Json,
        pbf: String,
        out_dir: String,
        primary_name: String = "power",
        force: Boolean = false,
        memory_gb: Int = 0
    ) => (
        sets: Json
    ) andThen foreach f in $.features {
        got = RetrieveFromPbf(
            region = $.region,
            feature = $.f,
            pbf = $.pbf,
            out_dir = $.out_dir,
            primary_name = $.primary_name,
            force = $.force,
            memory_gb = $.memory_gb
        ) with Requires(memory_gb = "$.memory_gb")
        yield RetrieveRegion(sets += got.result)
    }

    /** The grid for whole continents — and so for the world.
      *
      * BEYOND UPSTREAM PARITY. Upstream is per country and downloads from
      * Geofabrik; here each `regions` entry names an extract already in the
      * object store (`<pbf_base>/<region>-latest.osm.pbf`, the self-hosted
      * planet split), which is filtered to power and then extracted by the same
      * earth_osm. A region must also be an earth_osm region id — the eight
      * continent extracts are named exactly that way.
      *
      * `memory_gb` is the claim floor for extraction, which peaks at ~15 KB per
      * power feature. Measured 2026-10-17: Asia 8.75 GB (591k features),
      * Europe 7.2 GB (1.14M), North America 5.5 GB (430k). 10 covers every
      * continent. */
    workflow BuildRegionGrid(
        regions: Json,
        features: Json,
        out_dir: String,
        pbf_base: String = "s3://osm-extracts",
        primary_name: String = "power",
        force: Boolean = false,
        concurrency: Int = 2,
        memory_gb: Int = 10
    ) => (
        sets: Json,
        regions_done: Int
    ) andThen foreach r in $.regions limit $.concurrency {
        flt = Prefilter(
            pbf = $.pbf_base ++ "/" ++ $.r ++ "-latest.osm.pbf",
            out_dir = $.out_dir ++ "/_prefiltered",
            primary_name = $.primary_name,
            force = $.force
        )
        region = RetrieveRegion(
            region = $.r,
            features = $.features,
            pbf = flt.filtered,
            out_dir = $.out_dir,
            primary_name = $.primary_name,
            force = $.force,
            memory_gb = $.memory_gb
        )
        yield BuildRegionGrid(sets += region.sets, regions_done = 1)
    }

    /** One region's layers as one PMTiles file, for maps too large to embed.
      *
      * BEYOND UPSTREAM PARITY. Lines get a minzoom by voltage (>= 220 kV from
      * z0, distribution from z8) so a zoomed-out view shows the backbone rather
      * than a random sample. A file over `max_bytes` (GitHub Pages rejects
      * > 100 MB) is re-tiled one zoom shallower; the result records the maxzoom
      * it got. `dest` may be a local path or `s3://`. */
    event facet TileRegion(
        region: String,
        geojson_paths: Json,
        dest: String,
        maxzoom: Int = 12,
        max_bytes: Long = 95000000
    ) => (
        tiled: Json
    ) with Effect(kind = "io") with Cost(tier = "expensive") with Requires(memory_gb = 6)

    /** The MapLibre page over every region's PMTiles, referenced RELATIVE to
      * the page so the directory publishes as a unit. */
    event facet BuildTiledPage(
        tiled: Json,
        dest: String,
        title: String = "OpenStreetMap power grid"
    ) => (
        path: String,
        regions: Int
    ) with Effect(kind = "io") with Cost(tier = "cheap")

    /** The world's power grid as one map: per continent, filter → extract →
      * tile; then one page over all of them.
      *
      * `map_dir` receives `<region>.pmtiles` + `index.html`; for the local
      * gallery use `s3://afl-cache/cache/gridbuilder/maps/<name>`. */
    workflow BuildWorldGridMap(
        regions: Json,
        out_dir: String,
        map_dir: String,
        features: Json = ["substation", "line", "cable"],
        pbf_base: String = "s3://osm-extracts",
        title: String = "World power grid (OpenStreetMap)",
        concurrency: Int = 2,
        memory_gb: Int = 10,
        force: Boolean = false
    ) => (
        map: String,
        tiled: Json
    ) andThen {
        tiles = TileAll(
            regions = $.regions,
            features = $.features,
            out_dir = $.out_dir,
            map_dir = $.map_dir,
            pbf_base = $.pbf_base,
            concurrency = $.concurrency,
            memory_gb = $.memory_gb,
            force = $.force
        )
        page = BuildTiledPage(tiled = tiles.tiled, dest = $.map_dir ++ "/index.html", title = $.title)
        yield BuildWorldGridMap(map = page.path, tiled = tiles.tiled)
    }

    /** The per-region fan-out behind `BuildWorldGridMap`. */
    facet TileAll(
        regions: Json,
        features: Json,
        out_dir: String,
        map_dir: String,
        pbf_base: String,
        concurrency: Int,
        memory_gb: Int,
        force: Boolean
    ) => (
        tiled: Json
    ) andThen foreach r in $.regions limit $.concurrency {
        flt = Prefilter(
            pbf = $.pbf_base ++ "/" ++ $.r ++ "-latest.osm.pbf",
            out_dir = $.out_dir ++ "/_prefiltered",
            force = $.force
        )
        region = RetrieveRegion(
            region = $.r,
            features = $.features,
            pbf = flt.filtered,
            out_dir = $.out_dir,
            force = $.force,
            memory_gb = $.memory_gb
        )
        tile = TileRegion(region = $.r, geojson_paths = region.sets, dest = $.map_dir ++ "/" ++ $.r ++ ".pmtiles")
        yield TileAll(tiled += tile.tiled)
    }

    /** Retrieve a grid and draw it.
      *
      * The fan-out returns every (country, feature) set, and `BuildMap` takes
      * the GeoJSON paths straight from it — no second enumeration of the
      * output directory, so the map shows exactly what THIS run produced
      * rather than whatever else happens to be sitting in the bucket. */
    workflow BuildGridMap(
        countries: Json,
        features: Json,
        out_dir: String,
        source: String = "geofabrik",
        concurrency: Int = 2,
        use_mock: Boolean = false,
        title: String = "OpenStreetMap power grid",
        map_dest: String = "map.html"
    ) => (
        map: String,
        features_drawn: Int
    ) andThen {
        built = BuildGrid(
            countries = $.countries,
            features = $.features,
            out_dir = $.out_dir,
            source = $.source,
            concurrency = $.concurrency,
            use_mock = $.use_mock
        )

        // `map_dest` defaults to sitting beside the data, which is right for
        // `file://` and for browsing a bucket. To make it appear in the local
        // gallery (`fw svc maps`) it must follow that server's layout instead:
        //   s3://<bucket>/cache/gridbuilder/maps/<name>/index.html
        drawn = BuildMap(
            geojson_paths = built.sets,
            dest = $.map_dest,
            title = $.title
        )

        yield BuildGridMap(map = drawn.path, features_drawn = drawn.features)
    }

    /** Retrieve, then check the result is not empty.
      *
      * Kept separate from `BuildGrid` so the parity comparison stays honest:
      * `BuildGrid` is what upstream implements, this is what a pipeline that
      * has to trust its inputs would actually run. */
    workflow BuildGridChecked(
        countries: Json,
        features: Json,
        out_dir: String,
        source: String = "geofabrik",
        min_elements: Int = 1,
        concurrency: Int = 2,
        use_mock: Boolean = false
    ) => (
        sets: Json,
        report: String
    ) andThen {
        built = BuildGrid(
            countries = $.countries,
            features = $.features,
            out_dir = $.out_dir,
            source = $.source,
            concurrency = $.concurrency,
            use_mock = $.use_mock
        )

        // A manifest of what the run produced, next to the data it describes.
        // `fw.file.WriteJson` ships with the framework — no handler for it.
        manifest = fw.file.WriteJson(
            path = $.out_dir ++ "/manifest.json",
            data = built.sets,
            indent = 2
        )

        yield BuildGridChecked(sets = built.sets, report = manifest.path)
    }
}
